# Copia questo file in ".env" (nella stessa cartella) e compila i valori.
# Il file .env contiene segreti: è escluso dal repository (.gitignore).

# --- OpenAI (estrazione, trascrizione, agente) ---
OPENAI_API_KEY=

# --- Telegram ---
# Token del bot, dato da @BotFather
TELEGRAM_BOT_TOKEN=
# Id Telegram degli utenti autorizzati, separati da virgola.
# Per scoprire il proprio id: lasciare vuoto, avviare il bot e scrivergli /start.
TELEGRAM_UTENTI_AUTORIZZATI=
# Id dei gruppi Telegram in cui lavora il bot (numeri negativi, separati da virgola): chi è nel gruppo
# può usarlo. Per scoprire l'id: aggiungere il bot al gruppo e scrivere /start.
# Nel gruppo il bot deve leggere anche i file: da @BotFather, /setprivacy -> Disable.
TELEGRAM_GRUPPI_AUTORIZZATI=

# --- Google Drive e Gmail ---
# Nome della cartella privata su Drive dove archiviare gli originali
DRIVE_NOME_CARTELLA=Fatture - Assistente AI
# Indirizzo del commercialista a cui inviare i riepiloghi
COMMERCIALISTA_EMAIL=
# (servono anche segreti/google_credenziali.json e segreti/google_token.json: vedi README)

# --- Avvisi ---
# Canali: telegram, email (anche entrambi: telegram,email). Vuoto = solo log/errori.log
AVVISI_CANALI=telegram
# Destinatari degli avvisi (liste separate da virgola)
AVVISI_TELEGRAM_CHAT_ID=
AVVISI_EMAIL=
# Avviso quando si registra una fattura da almeno questo importo (euro)
AVVISI_SOGLIA_IMPORTO_EURO=5000
# Controllo giornaliero delle scadenze: ora (HH:MM, ora italiana) e giorni di anticipo
AVVISI_ORA_CONTROLLO=09:00
AVVISI_GIORNI_SCADENZA=7
# Avviso tecnico se lo stesso servizio sbaglia N volte in X minuti, poi pausa di Y minuti
AVVISI_ERRORI_SOGLIA=3
AVVISI_ERRORI_FINESTRA_MINUTI=15
AVVISI_PAUSA_MINUTI=60

# --- Solo versione 2 ---
# Sopra questo importo (euro) il percorso delle bozze chiede una seconda conferma prima di registrare
DOPPIA_CONFERMA_EURO=5000

# --- Facoltativo ---
# Cartella dei dati (registro, bozze, file ricevuti). Predefinita: ./dati
# CARTELLA_DATI=

# --- v3: la nostra azienda (compare come CLIENTE in ogni fattura, mai come fornitore) ---
AZIENDA_NOME="Impresa Cliente SRL"
AZIENDA_PIVA="IT09999999999"
# Cartelle condivise con l'amministrazione (es. una cartella cloud sincronizzata o montata sul server):
# blocchi mensili della registrazione (una sottocartella per mese) e scadenziario annuale + file dei termini.
# CARTELLA_REGISTRAZIONE=
# CARTELLA_SCADENZIARIO=
# NOME_FILE_TERMINI="Termini Di Pagamento Scadenziario Fatture.xlsx"
# Ogni fattura confermata in chat va anche nello scadenziario annuale (1 = sì)
# SCADENZIARIO_ANNUALE=1
# Archiviazione degli originali su Google Drive (0 = spenta)
# ARCHIVIA_SU_DRIVE=0
# Verifica automatica delle partite IVA britanniche (facoltativa, app gratuita su HMRC Developer Hub)
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
