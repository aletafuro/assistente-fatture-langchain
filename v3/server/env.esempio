# Modello del file /opt/bot-fatture/.env sul server. I valori segreti si scrivono SOLO sul server,
# mai qui, mai su GitLab, mai in chat. Permessi del file: chmod 600.

# --- segreti ---
OPENAI_API_KEY=
# token del bot (da @BotFather; se esce dal server o finisce in una chat: /revoke e token nuovo)
TELEGRAM_BOT_TOKEN=

# --- chi usa il bot ---
# id del gruppo Telegram dell'amministrazione (numero negativo): si scopre aggiungendo il bot al gruppo e scrivendo /start
TELEGRAM_GRUPPI_AUTORIZZATI=
# id di chi può scrivere al bot anche in privato (assistenza), separati da virgola
TELEGRAM_UTENTI_AUTORIZZATI=

# --- azienda ---
AZIENDA_NOME="Impresa Cliente SRL"
AZIENDA_PIVA="IT09999999999"

# --- avvisi (errori tecnici e scadenze) ---
AVVISI_CANALI=telegram
# dove mandare gli avvisi: il gruppo e/o chi fa assistenza
AVVISI_TELEGRAM_CHAT_ID=
AVVISI_ORA_CONTROLLO=09:00

# --- modelli (scelti con le prove MLflow: si cambiano qui, non nel codice) ---
MODELLO_LETTURA_TESTO=gpt-4.1-mini
MODELLO_LETTURA_FOTO=gpt-4.1-mini
MODELLO_INTERPRETE=gpt-4o-mini

# originali delle fatture: sono già su ownCloud, niente Google Drive
ARCHIVIA_SU_DRIVE=0
# regime IVA: le italiane le contabilizza l'amministrazione con i suoi sistemi, nessun avviso
AVVISO_REGIME_IVA=0

# Le cartelle (dati, registrazione, scadenziario) sono già impostate in compose.yaml.
